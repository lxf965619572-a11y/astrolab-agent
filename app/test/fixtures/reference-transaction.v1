#!/bin/sh
# 部门工作台的 Git 防护：只放行工作台界面发起的操作（界面在环境变量里设置 DEPT_UI_GIT=1）。
# reference-transaction 钩子在任何引用更新（提交、建分支、reset、stash 等）之前运行，
# 不能用 --no-verify 跳过，所以能拦住智能体在工作区里自行提交。
# 这是防误操作，不是防恶意：知道这个变量的人可以绕过。
if [ "$1" = "prepared" ] && [ "$DEPT_UI_GIT" != "1" ]; then
  echo "部门工作台：智能体不能提交、建分支或改动引用；请由用户在工作台界面上操作。" >&2
  exit 1
fi
exit 0
