# 本地环境变量（不要提交到代码仓库、不要发给别人）
# 由 setup.ps1 从 local.env.example 复制生成；start-web.ps1 启动时读入。

# DeepSeek 官方 API Key（https://platform.deepseek.com 申请）。
# 注意：使用官方 API 时，代码会发送到 DeepSeek 云端，只能用示例代码或非敏感代码测试。
DEEPSEEK_API_KEY=

# Cppcheck 可执行文件路径。留空则自动查找（PATH 和 C:\Program Files\Cppcheck）。
CPPCHECK_PATH=

# 部门 Cppcheck 抑制清单（可选）
CPPCHECK_SUPPRESSIONS=

# 文档生成服务（docgen）允许写入的目录，多个用分号分隔。
# 留空时只允许写启动 DSH 时的工作区（默认 sample）。在界面里添加了其他工作区时，要把它们加到这里，例如：
# DOC_ALLOWED_ROOTS=D:\lixf\astrolab-agent\sample;D:\work\TMU
DOC_ALLOWED_ROOTS=

# Word 模板目录，多个用分号分隔。留空时使用 config\templates
DOCGEN_TEMPLATE_DIR=

# 单元测试服务（utest）用的编译器。留空时用 PATH 中的 gcc。
# 推荐 MSYS2 UCRT64 的 gcc（见 README“单元测试”一节），例如：
# UTEST_CC=C:\msys64\ucrt64\bin\gcc.exe
UTEST_CC=
# C++ 编译器（gtest 用）和 gcov。留空时取 UTEST_CC 同目录下的 g++.exe、gcov.exe
UTEST_CXX=
UTEST_GCOV=
# 自己编译的 gtest 安装目录（含 include、lib）。用 MSYS2 的 gtest 包时留空
UTEST_GTEST_ROOT=

# 关闭 DSH 遥测（不要改）
DSH_TELEMETRY_DISABLED=1

# 以后切换到内网模型时，在这里填内网网关地址（兼容 Messages API 的地址），并换成内网 Key：
# DEEPSEEK_BASE_URL=http://llm-gw.dept.local:4000
