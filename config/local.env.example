# 本地环境变量（不要提交到代码仓库、不要发给别人）
# 由 setup.ps1 从 local.env.example 复制生成；start-web.ps1 启动时读入。

# DeepSeek 官方 API Key（https://platform.deepseek.com 申请）。
# 注意：使用官方 API 时，代码会发送到 DeepSeek 云端，只能用示例代码或非敏感代码测试。
DEEPSEEK_API_KEY=

# Cppcheck 可执行文件路径。留空则自动查找（PATH 和 C:\Program Files\Cppcheck）。
CPPCHECK_PATH=

# 部门 Cppcheck 抑制清单（可选）
CPPCHECK_SUPPRESSIONS=

# 关闭 DSH 遥测（不要改）
DSH_TELEMETRY_DISABLED=1

# 以后切换到内网模型时，在这里填内网网关地址（兼容 Messages API 的地址），并换成内网 Key：
# DEEPSEEK_BASE_URL=http://llm-gw.dept.local:4000
