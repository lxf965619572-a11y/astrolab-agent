# 使用场景：麒麟操作系统（银河麒麟桌面 V10 / V11，x86_64 或 aarch64）上的工作台 + 局域网服务器上的 Qwen3.8-27B（vLLM 或 SGLang）
# 安装脚本 install.sh 首次安装时把它复制成 ~/.local/share/AstroLab/local.env；带 --llm 时再用模型探测把地址、模型名、上下文填好。
# 也可以手工复制后改。格式和 config/local.env.example 相同，说明见 packaging/麒麟部署说明.md。
# 不要把真实的密钥写进这个文件（它在代码仓库里）。

# ── 模型：局域网服务器上的 vLLM（OpenAI 兼容接口）──
# 地址末尾要带 /v1；端口是 vllm serve 的 --port
DEPT_LLM_BASE_URL=http://192.168.10.20:8000/v1
# vLLM 没设 --api-key 时随便填一个非空值；设了就填它
DEPT_LLM_API_KEY=EMPTY
# vLLM 的 --served-model-name
DEPT_LLM_MODEL=qwen3.8-27b
# Qwen 的思考开关写在 chat_template_kwargs（enable_thinking、preserve_thinking）
DEPT_LLM_THINKING_FORMAT=qwen-chat-template
# 和服务端 --max-model-len 一致（Qwen3.8-27B 原生 262144；131072 是显存和并发的折中）
DEPT_LLM_CONTEXT_WINDOW=131072
# 单次输出上限：思考 + 回复，取上下文的四分之一
DEPT_LLM_MAX_TOKENS=32768
# 服务端没加 --language-model-only 时可以改成 text,image，让智能体看图（流程图、截图）
DEPT_LLM_INPUT=text

# ── 工具：用系统的（麒麟软件源或安装包带的离线包：gcc、cppcheck、git、bubblewrap）──
# 留空时按 PATH 找 gcc、cppcheck
UTEST_CC=
CPPCHECK_PATH=
# 编码环节的目标机交叉编译器（有就填），例如 D2000：/opt/toolchain/bin/aarch64-linux-gnu-gcc
TARGET_CC_SPARC=
TARGET_CC_D2000=

# ── 数据范围：模型在局域网内，任务记录、资料库都可以交给它 ──
ASTROLAB_DISTILL_SCOPE=all
ASTROLAB_REFERENCE_SCOPE=all

# ── 麒麟上的显示开关（遇到问题再打开）──
# 窗口右上角没有最小化、关闭按钮时：用系统标题栏
ASTROLAB_NATIVE_FRAME=
# 窗口花屏、白屏或启动就退出（个别国产显卡驱动）时：关掉 GPU 加速
ASTROLAB_DISABLE_GPU=

# 不往外发数据（不要改）
DSH_TELEMETRY_MODE=DISABLED

# 软件更新位置：部门发布新版本的共享目录（NFS、Samba 挂载点），里面有 latest.json
ASTROLAB_UPDATE_DIR=
