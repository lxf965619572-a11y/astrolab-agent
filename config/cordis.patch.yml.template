# 部门 DSH 补丁层（home 级，放在 $DSH_HOME\cordis.patch.yml）
# 由 setup.ps1 从本模板生成：__STARTER_DIR__ 会被替换成本文件夹的绝对路径。
# 修改后无需重启 dsh：热重载（HMR）会自动应用；若未生效，重启 start-web.ps1。

- insert:
    # Cppcheck 静态分析服务（stdio，由 dsh 自动拉起）
    - id: mcp-cppcheck
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: cppcheck
        transport: stdio
        command: !!js process.execPath     # 用运行 dsh 的同一个 node.exe，避免 PATH 问题
        args: ['__STARTER_DIR__/mcp/cppcheck/server.mjs']
        # CPPCHECK_PATH / CPPCHECK_SUPPRESSIONS 由 start-web.ps1 从 local.env 读入后自动继承
        toolCallTimeoutMs: 600000   # 静态分析可能较慢，放宽到 10 分钟

    # 文档读取服务：Word/Excel/PDF 转 Markdown（只读）
    - id: mcp-docreader
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: docreader
        transport: stdio
        command: !!js process.execPath
        args: ['__STARTER_DIR__/mcp/docreader/server.mjs']
        toolCallTimeoutMs: 120000   # 大文档或 PDF 解析可能较慢

    # 文档生成服务：Markdown 套 Word 模板生成 .docx，表格导出 .xlsx
    # 模板目录默认 config/templates；DOC_ALLOWED_ROOTS / DOCGEN_TEMPLATE_DIR 由 start-web.ps1 从 local.env 读入后继承
    - id: mcp-docgen
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: docgen
        transport: stdio
        command: !!js process.execPath
        args: ['__STARTER_DIR__/mcp/docgen/server.mjs']
        toolCallTimeoutMs: 120000

    # 单元测试服务：主机上编译运行手写驱动/桩或 gtest，gcov 统计语句、分支、MC/DC 覆盖率
    # 编译器 UTEST_CC 等由 start-web.ps1 从 local.env 读入后继承；构建目录在工作区的 .utest 下
    - id: mcp-utest
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: utest
        transport: stdio
        command: !!js process.execPath
        args: ['__STARTER_DIR__/mcp/utest/server.mjs']
        toolCallTimeoutMs: 600000   # 编译、运行和覆盖率统计，大模块可能较慢

# 部门 Skills：让 DSH 直接读取本工程的 skills 目录（不再复制到 DSH 数据目录）。
# DSH 每次加载 Skill 都重新读取文件，所以改了 skills\ 下的文件不用重新运行 setup.ps1，新建会话即可。
# Web 组合包（dsh-web-app）禁用了宿主层的 skill-filesystem，改由各 agent preset 自己挂载；
# 宿主层的提供方注册在全局层，所有 preset 的 Skill 目录都会合并它，所以这里重新启用宿主行，
# 只扫描本工程的 skills（includeDefaultRoots: false，项目和用户目录仍由 preset 自己扫描）。
# 按 id 打补丁会替换整个 config。
- id: skill-filesystem
  name: '@deepseek-ai/dsh-skill-filesystem'
  disabled: false
  config:
    providerName: dept-skills
    includeDefaultRoots: false
    customSkillDirs: ['__STARTER_DIR__/skills']
