# 钩子是 sh 脚本：Windows 上 core.autocrlf=true 检出成 CRLF 会坏掉（then\r），固定 LF
app/git-hooks/* text eol=lf
dsh-dept/hooks/* text eol=lf
dsh-dept/trial/*.cmd text eol=crlf
# 麒麟（Linux）安装包的脚本和桌面文件：在 Windows 上检出、打包也必须是 LF，否则 bash 报 $'\r': command not found
*.sh text eol=lf
packaging/linux/* text eol=lf
config/scenarios/* text eol=lf
